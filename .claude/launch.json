{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "questhub",
      "runtimeExecutable": "./.mamba-env/bin/python",
      "runtimeArgs": [
        "-m",
        "questhub",
        "--no-browser",
        "-v"
      ],
      "port": 8765
    },
    {
      "name": "questhub-poc",
      "runtimeExecutable": "./.mamba-env/bin/python",
      "runtimeArgs": [
        "-m",
        "questhub.poc",
        "--port",
        "8770",
        "-v"
      ],
      "port": 8770
    },
    {
      "name": "questhub-loadtest",
      "runtimeExecutable": "./.mamba-env/bin/python",
      "runtimeArgs": [
        "tools/loadtest.py",
        "--devices",
        "50",
        "--port",
        "8790"
      ],
      "port": 8790
    }
  ]
}
